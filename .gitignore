# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
*.env

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/

# Test and coverage outputs
.pytest_cache/
.coverage
htmlcov/

# Build files
build/
dist/
*.egg-info/

# Streamlit local config
.streamlit/secrets.toml

# Large/raw data files
data/raw/*
data/interim/*
data/processed/*

# Keep folder structure
!data/raw/.gitkeep
!data/raw/oulad/.gitkeep
!data/raw/synthetic/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Reports generated locally
reports/*.pdf
reports/*.html

# Allow sample reports if intentionally added
!reports/sample_executive_summary.md

# Logs
*.log

# Temporary files
*.tmp
*.bak
